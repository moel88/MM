{
 "multipart": [
  {
   "apply": {
    "model": "celestialfall:block/town/net_post"
   }
  },
  {
   "apply": {
    "model": "celestialfall:block/town/net_side"
   },
   "when": {
    "north": "true"
   }
  },
  {
   "apply": {
    "model": "celestialfall:block/town/net_side",
    "y": 90
   },
   "when": {
    "east": "true"
   }
  },
  {
   "apply": {
    "model": "celestialfall:block/town/net_side_alt"
   },
   "when": {
    "south": "true"
   }
  },
  {
   "apply": {
    "model": "celestialfall:block/town/net_side_alt",
    "y": 90
   },
   "when": {
    "west": "true"
   }
  },
  {
   "apply": {
    "model": "celestialfall:block/town/net_noside"
   },
   "when": {
    "north": "false"
   }
  },
  {
   "apply": {
    "model": "celestialfall:block/town/net_noside_alt"
   },
   "when": {
    "east": "false"
   }
  },
  {
   "apply": {
    "model": "celestialfall:block/town/net_noside_alt",
    "y": 90
   },
   "when": {
    "south": "false"
   }
  },
  {
   "apply": {
    "model": "celestialfall:block/town/net_noside",
    "y": 270
   },
   "when": {
    "west": "false"
   }
  }
 ]
}
